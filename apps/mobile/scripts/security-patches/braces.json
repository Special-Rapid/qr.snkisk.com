          "from": "'use strict';",
          "to": "'use strict';\n\nconst { MAX_DEPTH } = require('./constants');\n\n// parent参照を追わず、共有nodeも各参照pathで検査する。\nexports.assertDepth = ast => {\n  const pending = [{ node: ast, depth: 0 }];\n  while (pending.length > 0) {\n    const { node, depth } = pending.pop();\n    if (!node.nodes) continue;\n    if (depth > MAX_DEPTH) throw new SyntaxError('Brace nesting exceeds maximum depth');\n    for (const child of node.nodes) pending.push({ node: child, depth: depth + 1 });\n  }\n};\n",
